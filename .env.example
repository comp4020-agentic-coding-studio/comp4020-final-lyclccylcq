# Wayline configuration. Copy what you need into your environment (locally:
# mise.local.toml's [env] table, which is gitignored; on Fly:
# `fly secrets set NAME=value`). Never commit real values. Everything is
# optional: without a key the matching feature switches off and the app says so.
#
# Google Cloud setup (one project, two keys):
#   1. Enable these APIs: Maps JavaScript API, Places API (New), Routes API,
#      Geocoding API. (Not the legacy "Places API" or "Directions API".)
#   2. Create the BROWSER key below. Application restriction: Websites, with
#      https://<your-app>.fly.dev/* and http://localhost:8080/*. API
#      restriction: Maps JavaScript API only.
#   3. Create the SERVER key below. Application restriction: none (or your
#      server's IP if it is fixed). API restriction: Places API (New), Routes
#      API, Geocoding API.
#   4. Set a budget alert and quotas in the Cloud console.

# --- Google Maps Platform -------------------------------------------------
# Browser key: sent to browsers by design, for the interactive map.
GOOGLE_MAPS_BROWSER_KEY=

# Optional map id for Advanced Markers (Map Management in the console).
# Defaults to Google's DEMO_MAP_ID, fine for development.
GOOGLE_MAPS_MAP_ID=

# Server key: Places (search, autocomplete, nearby, details, photos), Routes
# and Geocoding. Never sent to the browser.
GOOGLE_MAPS_SERVER_KEY=

# --- AI copilot -------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
WAYLINE_AI_MODEL=claude-opus-5-5

# --- Runtime (set by fly.toml / the Dockerfile in production) ---------------
# PORT=8080
# DATA_DIR=./data

# --- Tests only -------------------------------------------------------------
# spec/google-mock.test.ts points these at a local stand-in. Leave unset in
# real deployments; they default to Google's own hosts.
# GOOGLE_PLACES_BASE_URL=
# GOOGLE_ROUTES_BASE_URL=
# GOOGLE_GEOCODE_BASE_URL=
