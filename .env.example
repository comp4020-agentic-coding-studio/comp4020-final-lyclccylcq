# Wayline configuration. Locally, copy this to `.env` (gitignored; `pnpm dev`
# and `pnpm start` read it). On Fly: `fly secrets set NAME=value`. Never
# commit real values. Everything is optional: without a key the matching
# feature switches off and the app says so.
#
# Google Maps needs TWO DIFFERENT keys, never the same value in both: the
# browser key is public by design, so a shared key exposes the server's
# access too (the server warns at startup if they match). Full setup,
# restrictions, Fly secrets and rotation: docs/google-maps-keys.md.

# --- Google Maps Platform -------------------------------------------------
# Browser key: sent to browsers by design, for the interactive map.
GOOGLE_MAPS_BROWSER_KEY=

# Optional map id for Advanced Markers (Map Management in the console).
# Defaults to Google's DEMO_MAP_ID, fine for development.
GOOGLE_MAPS_MAP_ID=

# Server key: Places (search, autocomplete, nearby, details, photos), Routes
# and Geocoding. Never sent to the browser.
GOOGLE_MAPS_SERVER_KEY=

# --- AI copilot -------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
WAYLINE_AI_MODEL=claude-opus-5-5

# --- Runtime (set by fly.toml / the Dockerfile in production) ---------------
# PORT=8080
# DATA_DIR=./data

# --- Tests only -------------------------------------------------------------
# spec/google-mock.test.ts points these at a local stand-in. Leave unset in
# real deployments; they default to Google's own hosts.
# GOOGLE_PLACES_BASE_URL=
# GOOGLE_ROUTES_BASE_URL=
# GOOGLE_GEOCODE_BASE_URL=
