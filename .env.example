# Wayline configuration. Copy what you need into your environment (locally:
# mise.local.toml's [env] table, which is gitignored; on Fly: `fly secrets set`).
# Never commit real values. Everything is optional: without a key the matching
# feature is switched off and the app says so.

# --- Google Maps Platform -------------------------------------------------
# Browser key: Maps JavaScript API only. It IS sent to browsers, so restrict
# it in Google Cloud Console to HTTP referrers (your *.fly.dev domain and
# http://localhost:8080/*) and to the Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=

# Optional map id for Advanced Markers (create one under Map Management).
# Defaults to Google's DEMO_MAP_ID, which is fine for development.
GOOGLE_MAPS_MAP_ID=

# Server key: Places API (New) and Routes API. Never sent to the browser.
# Restrict it to those two APIs; don't add a referrer restriction.
GOOGLE_MAPS_SERVER_KEY=

# --- AI copilot -------------------------------------------------------------
# Anthropic API key for the schedule copilot. Server-side only.
ANTHROPIC_API_KEY=
# Optional: a different endpoint (e.g. a proxy), and model.
ANTHROPIC_BASE_URL=
WAYLINE_AI_MODEL=claude-opus-5-5

# --- Runtime (set by fly.toml / the Dockerfile in production) ---------------
# PORT=8080
# DATA_DIR=./data
